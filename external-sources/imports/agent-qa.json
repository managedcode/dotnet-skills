  },
  "licenseFile": "LICENSE.md",
  "pluginOverrides": {
    "agent-qa-authoring": {
      "package": "agent-qa-authoring",
      "title": "vostride: agent-qa-authoring"
    },
    "agent-qa-debug-fix": {
      "package": "agent-qa-debug-fix",
      "title": "vostride: agent-qa-debug-fix"
    },
    "agent-qa-knowledge": {
      "package": "agent-qa-knowledge",
      "title": "vostride: agent-qa-knowledge"
    },
    "agent-qa-result-triage": {
      "package": "agent-qa-result-triage",
      "title": "vostride: agent-qa-result-triage"
    }
  }
}
